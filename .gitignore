# Generated data: everything the scripts write under data/dataset/pkl/ is rebuilt from the CSVs
# (binary pickles and TorchScript regressors are not portable across library versions)
**/*.pkl
**/*.pt
data/dataset/pkl/**
!data/dataset/pkl/**/
!data/dataset/pkl/**/.gitkeep

# Local training runs (the published weights are data/ml_model/ml_dicts/*.dict)
data/ml_model/intermediate_models/

# Scratch output of the continuation scripts (the plots in output/ are part of the repository)
output/**/temp/

# Python
__pycache__/
*.pyc
.venv/
*.log
*.out
.ipynb_checkpoints/
.DS_Store
